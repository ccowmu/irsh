#!/usr/bin/env python3

import path
import os
from sys import argv, exit, stdin, stderr
import re
import markovify

self = os.path.basename(__file__)

if len(argv) == 1:
    text = stdin.buffer.read().decode('utf-8')
elif len(argv) == 2:
    try:
        with open(path.chan_path(os.environ['CHAN'], argv[1])) as f:
            text = f.read()
    except FileNotFoundError:
        print('{}: {}: No such file'.format(self, argv[1]), file=stderr)
        exit(1)
else:
    print('{}: Invalid commandline'.format(self), file=stderr)
    exit(1)

text = re.sub(r'\n\s*\n', '\n', text, re.MULTILINE)
try:
    # A two-word state is useful for large corpora, but filtered input often
    # contains only a handful of unrelated lines.  In that case almost every
    # generated sentence is an unchanged source line (which markovify rejects)
    # and the few remaining paths can collapse to one repeated result.
    line_count = sum(bool(line.strip()) for line in text.splitlines())
    state_size = 1 if line_count < 50 else 2
    text_model = markovify.NewlineText(
        text,
        state_size=state_size,
        well_formed=False,
    )
    sentence = text_model.make_sentence(tries=50)
except:
    sentence = None

if sentence is None:
    print('{}: Markov generation failed'.format(self), file=stderr)
    exit(1)

print(sentence)
